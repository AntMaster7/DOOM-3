/* GENERATED by tools\port-x64\gen_qgl_null.py from QGL_Init: do not edit.
   r_swRenderer 2: no opengl32.dll. Every qgl / qwgl pointer is a no-op that counts its calls;
   QGL_NullReport lists them. One stub per entry point, handed out by name, so an extension
   pointer asked for at run time (GLimp_ExtensionPointer) gets one as well.
   The stub takes no arguments and returns 0 in RAX: valid for every GL signature under the x64
   calling convention (arguments in registers or caller-cleaned stack). x64 only, as is the mode. */

#define QGL_NULL_STUBS 640
static int			qglNullCalls[QGL_NULL_STUBS];
static const char *	qglNullNames[QGL_NULL_STUBS];
static int			qglNullCount;

template< int N > static intptr_t APIENTRY QGL_NullStub( void ) { qglNullCalls[N]++; return 0; }
#define QGL_S8( b ) (void *)&QGL_NullStub< b >, (void *)&QGL_NullStub< b + 1 >, (void *)&QGL_NullStub< b + 2 >, (void *)&QGL_NullStub< b + 3 >, \
	(void *)&QGL_NullStub< b + 4 >, (void *)&QGL_NullStub< b + 5 >, (void *)&QGL_NullStub< b + 6 >, (void *)&QGL_NullStub< b + 7 >
#define QGL_S64( b ) QGL_S8( b ), QGL_S8( b + 8 ), QGL_S8( b + 16 ), QGL_S8( b + 24 ), QGL_S8( b + 32 ), QGL_S8( b + 40 ), QGL_S8( b + 48 ), QGL_S8( b + 56 )
static void * const qglNullStubs[QGL_NULL_STUBS] = {
	QGL_S64( 0 ), QGL_S64( 64 ), QGL_S64( 128 ), QGL_S64( 192 ), QGL_S64( 256 ), QGL_S64( 320 ), QGL_S64( 384 ), QGL_S64( 448 ), QGL_S64( 512 ), QGL_S64( 576 )
};

static void *QGL_NullProc( const char *name ) {
	for ( int i = 0; i < qglNullCount; i++ ) {
		if ( !strcmp( qglNullNames[i], name ) ) {
			return qglNullStubs[i];
		}
	}
	if ( qglNullCount == QGL_NULL_STUBS - 1 ) {
		qglNullNames[qglNullCount] = "(more entry points than stubs)";
		return qglNullStubs[qglNullCount];
	}
	qglNullNames[qglNullCount] = Mem_CopyString( name );		// extension names come from the caller's stack or literals: keep a copy
	return qglNullStubs[qglNullCount++];
}

// ---- the entry points whose answer the engine depends on

static const GLubyte * APIENTRY QGL_NullGetString( GLenum name ) {
	switch ( name ) {
	case GL_VENDOR:		return (const GLubyte *)"DOOM 3 software renderer";
	case GL_RENDERER:	return (const GLubyte *)"AVX-512 tile rasterizer (no OpenGL)";
	case GL_VERSION:	return (const GLubyte *)"1.5 none";
	// what the ARB2 path and the software back end rely on, and nothing else: no texture compression
	// (the CPU twins want RGBA), no vertex buffer objects (the vertex cache stays in CPU memory)
	case GL_EXTENSIONS:	return (const GLubyte *)"GL_ARB_multitexture GL_ARB_texture_env_combine GL_ARB_texture_cube_map "
							"GL_ARB_texture_env_dot3 GL_ARB_texture_env_add GL_ARB_texture_non_power_of_two GL_EXT_stencil_wrap "
							"GL_EXT_stencil_two_side GL_ARB_vertex_program GL_ARB_fragment_program GL_EXT_depth_bounds_test";
	}
	return (const GLubyte *)"";
}

static void APIENTRY QGL_NullGetIntegerv( GLenum pname, GLint *params ) {
	switch ( pname ) {
	case GL_MAX_TEXTURE_SIZE:				*params = 8192; break;
	case GL_MAX_TEXTURE_UNITS_ARB:			*params = 8; break;
	case GL_MAX_TEXTURE_COORDS_ARB:			*params = 8; break;
	case GL_MAX_TEXTURE_IMAGE_UNITS_ARB:	*params = 8; break;
	case GL_PROGRAM_ERROR_POSITION_ARB:		*params = -1; break;	// "the program compiled"
	default:								*params = 0; break;
	}
}

static void APIENTRY QGL_NullGenTextures( GLsizei n, GLuint *textures ) {
	static GLuint next = 1024;		// idImage tells "loaded" from its texnum
	for ( GLsizei i = 0; i < n; i++ ) {
		textures[i] = next++;
	}
}

static PROC WINAPI QGL_NullGetProcAddress( LPCSTR name ) {
	return (PROC)QGL_NullProc( name );
}

