/* The stray-call report. Stage 9 is done when it is empty and opengl32.dll is not in the process. */
void QGL_NullReport( bool all ) {
	int total = 0, entries = 0;
	for ( int i = 0; i < qglNullCount; i++ ) {
		if ( qglNullCalls[i] ) {
			total += qglNullCalls[i];
			entries++;
		}
	}
	common->Printf( "stray OpenGL calls: %i through %i entry points; opengl32.dll is %s\n", total, entries,
		GetModuleHandle( "opengl32.dll" ) ? "LOADED" : "not loaded" );
	// most calls first
	for ( int printed = 0; printed < ( all ? entries : Min( entries, 40 ) ); printed++ ) {
		int best = -1;
		for ( int i = 0; i < qglNullCount; i++ ) {
			if ( qglNullCalls[i] > 0 && ( best < 0 || qglNullCalls[i] > qglNullCalls[best] ) ) {
				best = i;
			}
		}
		if ( best < 0 ) {
			break;
		}
		common->Printf( "  %9i  %s\n", qglNullCalls[best], qglNullNames[best] );
		qglNullCalls[best] = -qglNullCalls[best];		// printed
	}
	for ( int i = 0; i < qglNullCount; i++ ) {
		if ( qglNullCalls[i] < 0 ) {
			qglNullCalls[i] = -qglNullCalls[i];
		}
	}
}
