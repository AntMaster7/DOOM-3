<?xml version="1.0" encoding="utf-8"?>
<!--
  Retargets all projects in this solution to build with Visual Studio 2026 (v145 toolset)
  and the installed Windows 10/11 SDK, without modifying each .vcxproj individually.
  MSBuild imports this file automatically for every project under this directory.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PlatformToolset>v145</PlatformToolset>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <!--
        ID_ENFORCE_KEY=0: the retail CD-key check authenticates against id's
        master servers, which no longer exist, so with enforcement on the
        engine ignores startup +commands and blocks StartNewGame. Game assets
        still have to be owned/installed; this only disables the dead check.
      -->
      <PreprocessorDefinitions>ID_ENFORCE_KEY=0;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
